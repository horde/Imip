{
    "name": "horde/imip",
    "description": "A library to handle the iMip protocol to send MIME encapsuled iTip responses to iCalendar invitations. Ties into horde/itip and horde/icalendar.",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Imip",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "lead"
        },
        {
            "name": "Gunnar Wrobel",
            "email": "p@rdus.de",
            "role": "developer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../Icalendar",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "../Itip",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "../Mime",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "../Mail",
            "options": {"symlink": true}
        }
    ],
    "require": {
        "php": "^8.1",
        "horde/icalendar": "@dev",
        "horde/itip": "@dev",
        "horde/mime": "@dev"
    },
    "require-dev": {
        "horde/mail": "@dev"
    },
    "suggest": {
        "horde/mail": "Required for actual email delivery via ImipSendingListener"
    },
    "autoload": {
        "psr-4": {
            "Horde\\Imip\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Imip\\Test\\": "test/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "1.x-dev"
        }
    }
}
