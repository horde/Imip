{
    "name": "horde/imip",
    "description": "iMip inivitation protocol library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Imip",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Gunnar Wrobel",
            "email": "p@rdus.de",
            "role": "inherited"
        },
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "lead"
        }
    ],
    "keywords": [
        "imip",
        "invitations",
        "responses"
    ],
    "time": "2026-05-21",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/icalendar": "^3 || dev-FRAMEWORK_6_0",
        "horde/itip": "^3 || dev-FRAMEWORK_6_0",
        "horde/mime": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/mail": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/mail": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-4": {
            "Horde\\Imip\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Imip\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "1.x-dev"
        }
    }
}